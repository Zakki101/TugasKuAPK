<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/tugascard" />
    <TextView
        android:id="@+id/tv_title_event"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:layout_marginHorizontal="5dp"
        android:textColor="@color/black"
        android:text="pergi ke dufan bareng temen"
        android:fontFamily="@font/intro_rust"
        android:textSize="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_event"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_awal_acara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:text="23/07/2025"
            android:textSize="12dp"
            android:textColor="@color/black"
            android:fontFamily="@font/intro_rust" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:layout_marginStart="5sp"
            android:textSize="12dp"
            android:textColor="@color/black"
            android:fontFamily="@font/intro_rust" />
        <TextView
            android:id="@+id/tv_akhir_acara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="28/07/2025"
            android:textSize="12dp"
            android:textColor="@color/black"
            android:fontFamily="@font/intro_rust"/>
    </LinearLayout>


    <TableLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_title_event"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="18dp">
        <TableRow>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lama ACara:"
                android:paddingStart="8dp"
                android:textSize="10dp"
                android:textColor="@color/black"
                android:fontFamily="@font/intro_rust" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_lamaacara"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp"
                    android:layout_marginStart="5dp"
                    android:text="5 Hari"
                    android:textSize="10dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/intro_rust" />
            </RelativeLayout>
        </TableRow>
    </TableLayout>

    <TextView
        android:id="@+id/tv_warna_event"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:textSize="10sp"
        android:fontFamily="@font/intro_rust"
        android:paddingTop="1sp"
        android:paddingStart="11dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/smooth_corners"
        android:layout_marginEnd="30dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" />
</RelativeLayout>
